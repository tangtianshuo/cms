FROM node:22-slim AS build

WORKDIR /app/storefront

COPY . /app

RUN npm i --prefix /app/storefront
RUN npm run build --prefix /app/storefront

FROM node:22-slim

WORKDIR /app/storefront

COPY --from=build /app/storefront/.output /app/storefront/.output

ENV NITRO_HOST=0.0.0.0
ENV NITRO_PORT=3000

EXPOSE 3000

ENTRYPOINT ["node", "/app/storefront/.output/server/index.mjs"]
