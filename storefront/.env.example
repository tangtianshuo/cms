NUXT_CMS_INTERNAL_ORIGIN=http://localhost:8080
NUXT_PUBLIC_SITE_HOST=localhost:3000
NUXT_PUBLIC_ADMIN_ORIGIN=http://localhost:8080
# Required behind the trusted production gateway; keep these server-only.
# Must match backend STOREFRONT_GATEWAY_SECRET / STOREFRONT_DOMAIN_SECRET.
NUXT_GATEWAY_SECRET=
NUXT_DOMAIN_SECRET=
# Explicit local development exception; set true in production.
NUXT_DOMAIN_PRODUCTION=false
